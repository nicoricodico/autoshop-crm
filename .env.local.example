# Copy this file to .env.local for local dev, and set the same names in
# Vercel → Project → Settings → Environment Variables for Preview/Production
# (use a *different* Supabase project for Preview vs Production if you want
# a safe staging environment — never point Preview at prod data).

# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "Publishable key" (older dashboards call this the "anon" key) — safe to
# expose to the browser. RLS is what actually protects the data, not this
# key being secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# "Secret key" (older dashboards call this the "service_role" key) — NEVER
# expose this to the browser and never prefix it with NEXT_PUBLIC_. It's
# used only inside server-only API routes (setup, PIN login, team invites)
# to perform actions that must bypass Row Level Security by design, such as
# creating a brand-new organization and its first user.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Used by the PIN-login route to mint a real Supabase session from a
# verified PIN. Must match your deployed origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
